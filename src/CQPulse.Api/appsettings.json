{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "CQPulse": ""
  },
  "Simulator": {
    "MaxTestCount": 50000,
    "MaxConcurrency": 128,
    "MaxDurationMs": 60000,
    "LargeWorkloadThreshold": 10000,
    "QueueCapacity": 100,
    "ResultBufferCapacity": 2000,
    "ResultBatchSize": 500,
    "ProgressUpdatesPerRun": 100
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200"
    ]
  },
  "AllowedHosts": "*"
}
